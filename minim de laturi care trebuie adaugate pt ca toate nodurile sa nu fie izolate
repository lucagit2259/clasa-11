#include <iostream>
#include <fstream>
using namespace std;
int a[10][10], n, e[10];
ifstream f("fisier.txt");
void citeste()
{
    int i, j;
    f>>n;
    for ( i = 1; i <= n; i++)
    {
        for ( j = 1; j <= n; j++)
        {
            f>>a[i][j];
        }
    }
}
int minim()
{
    int i,j, l=0;
    for ( i = 1; i <= n; i++)
    {
        for ( j = 1; j <= n; j++)
        {
            if (a[i][j]==0)
                e[i]=e[i]+1;
        }
    }
    for ( i = 1; i <=n; i++)
    {
        if (e[i]==n)
            l++;
    }
    if (l==0)
        return 0;
    if (l==1)
        return 1;
    else if (l%2==0)
        return l/2;
    else return l/2+1;
    
}

int main()
{
    citeste();
    cout<<"sunt necesare cel putin inca "<<minim()<<" laturi pentru ca toate nodurile sa nu fie izolate ";
}
