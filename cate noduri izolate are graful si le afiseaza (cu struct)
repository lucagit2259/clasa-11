#include <iostream>
#include <fstream>
using namespace std;
ifstream f("graf.txt");
int contor, n, a[10][10], nr_muchii, x[100];
struct vecini
{
    int inceput;
    int sfarsit;
};

vecini t[100];
void citeste()
{
    f>>n;
    for (int i = 1; i <= n ; i++)
    {
        for (int j = 1; j <=n; j++)
        {
            f>>a[i][j];
        }
    }
}

void citeste_pt_lista()
{
    for (int i = 1; i <= n; i++)
    {
        for (int j = i+1; j <= n; j++)
        {
            if (a[i][j]==1)
            {
                t[nr_muchii].inceput=i;
                t[nr_muchii].sfarsit=j;
                nr_muchii++;
            }       
        }
    }
}
void afisare_pt_lista()
{
    for (int i = 0; i <nr_muchii; i++)
    {
        cout<<"["<<t[i].inceput<<"],["<<t[i].sfarsit<<"]\n";
    }
    
}
void vector_vecini()
{
  for (int j = 1; j <= n; j++)
  {
      for(int i = 0; i <= nr_muchii; i++)
    {
    if (t[i].inceput==j || t[i].sfarsit==j)
    {
      x[j]++;      
    }
  }
  } 
}
void noduri_izolate()
{
  for (int i = 1; i <=n; i++)
  {
    if (x[i]==0)
    {
      cout<<"\nnodul "<<i<<" este izolat";
      contor++;
    }
  }
}
int main()
{
    citeste();
    citeste_pt_lista();
    afisare_pt_lista();
    vector_vecini();
    noduri_izolate();
    if (contor==1)
    {
      cout<<"\nexista un nod izolat";
    }
    else cout<<"\nsunt "<<contor<<" noduri izolate ";
    return 0;
}
