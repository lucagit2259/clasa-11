#include <iostream>
using namespace std;
int v[100];

int sol;
int dei(int stanga, int dreapta, int &sol)
{
    if (stanga==dreapta){
    if (v[stanga] % 2==0)
    {
        return sol=1;   
    } else
    return sol=0;
    }
    else{
        int mid=(stanga+ dreapta)/2;
        int x1=0, x2=0;
        dei(stanga, mid, x1);
        dei(mid+1, dreapta, x2);
        sol=x1+x2; 
        return sol;       
    }
}
int main(){
    int n;
    cout<<"cate elemente introduci?\n";
    cin>>n;
    for (int i = 0; i < n; i++)
    {
        cout<<"introdu el poz "<<i+1<<": ";
        cin>>v[i];
    }
    dei(0, n-1, sol);
    cout<<sol;

    return 0; 

}
