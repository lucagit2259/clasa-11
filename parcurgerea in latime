#include <iostream>
#include <fstream>
using namespace std;
int a[100][100], n, vizitat[20], c[20];
ifstream f("graf.txt");
void citire()
{
    int x, y;
    f>> n;
    while (f >> x >> y)
    {
        a[x][y] = 1;
        a[y][x] = 1;
    }
    f.close();
}
void afisare()
{
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= n; j++)
        {
            cout << a[i][j] << " ";
        }
        cout << "\n";
    }
}
int parcurgere (int nod)
{
    int stanga, dreapta, i, k;
    stanga= dreapta=1;
    c[1]=nod;
    vizitat[nod]=1;
    while (stanga<=dreapta)
    {
        k=c[stanga];
        for ( i = 1; i <= n; i++)
            if (vizitat[i]==0 && a[k][i]==1)
            {
                vizitat[i]=1;
                dreapta++;
                c[dreapta]=i;
            }
            stanga++;
    }
    
    return dreapta;
}
int main()
{
    int nod;
    citire();
    cout << "matricea de adiacenta este: \n";
    afisare();
    cout<<"nodul de start de unde se va parcurge matricea este:\n";
    cin>>nod;
    cout<<"numarul de noduri vizitate este: "<<parcurgere (nod)<<"\n";
    cout<<"muchiile vizitate sunt:\n";
    for (int i = 1; i <= n; i++)
    {
        if (vizitat[i]==1)
        {
            cout<<i<<" ";
        } 
    }
    cout<<"\nnodurile au fost vizitate in ordinea urmatoare:\n";
    for (int i = 1; i <= n; i++)
    {
        cout<<c[i]<<" ";
    }
}
