#include <iostream>
#include <fstream>
using namespace std;
ifstream f("fisier.txt");
ofstream afis_izo ("izolat.txt");
ofstream afts_terminal ("terminal.txt");
ofstream afis_muchii ("muchii.txt");
int n, a[10][10], nr_muchii, x[100];
struct vecini
{
    int inceput;
    int sfarsit;
};
vecini t[100];
void citeste()
{
    f>>n;
    for (int i = 1; i <= n ; i++)
    {
        for (int j = 1; j <=n; j++)
        {
            f>>a[i][j];
        }
    }
    f.close();
}

void citeste_pt_lista()
{
    for (int i = 1; i <= n; i++)
    {
        for (int j = i+1; j <= n; j++)
        {
            if (a[i][j]==1)
            {
                t[nr_muchii].inceput=i;
                t[nr_muchii].sfarsit=j;
                nr_muchii++;
            }       
        }
    }
}
void afisare_pt_lista()
{
    for (int i = 0; i <nr_muchii; i++)
    {
        afis_muchii<<"["<<t[i].inceput<<"],["<<t[i].sfarsit<<"]\n";
    }
    afis_muchii.close();
}
void vector_vecini()
{
  for (int j = 1; j <= n; j++)
  {
      for(int i = 0; i <= nr_muchii; i++)
    {
    if (t[i].inceput==j || t[i].sfarsit==j)
    {
      x[j]++;      
    }
  }
  } 
}
void noduri_izolate_terminale_si_grade()
{
  for (int i = 1; i <=n; i++)
  {
    cout<<" nodul "<<i<<" are gradul "<<x[i]<<"\n";
    if (x[i]==0)
    {
      afis_izo<<"nodul "<<i<<" este izolat\n";
    }
    else if (x[i]==1)
    {
        afts_terminal<<"nodul "<<i<<" este terminal\n";
    }
    
  }
    afis_izo.close();
    afts_terminal.close();
}
int main()
{
    citeste();
    citeste_pt_lista();
    afisare_pt_lista();
    vector_vecini();
    noduri_izolate_terminale_si_grade();
    return 0;
}
