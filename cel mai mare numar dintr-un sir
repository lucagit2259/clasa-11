#include<iostream>

using namespace std;
int v[100] ,n;

int cmmdc(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int dei(int stanga, int dreapta, int &solutie){
    int x1, x2;
    if(stanga==dreapta)
        solutie=v[stanga];
    else {
        int mid = (stanga+dreapta)/2;
         dei(stanga, mid, x1);
         dei(mid + 1, dreapta, x2);
        if (x1> x2)
            solutie=x1;
        else
            solutie=x2;
    }
    return 0;
}
int main(){
    int solutie=0;
    cout<<"n = ";
    cin>>n;
    for (int i = 1; i <= n; i++)
    {
        cout<<"el.poz. "<<i<<": ";
        cin>>v[i];
    }
    dei(1, n, solutie);
  cout<<"cel mai mare numar este: "<<solutie;   
}
