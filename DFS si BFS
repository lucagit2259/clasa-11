#include <iostream>
#include <fstream>

using namespace std;

int n, a[10][10], v[10];

void creare_matrice_adiacenta() 
{   
    fstream f("graf.txt");
    int i,x,y;
    f>>n;
    while(f >> x >> y) a[x][y] = a[y][x] = 1;
    f.close();
}
void afisare_adiacenta()
{
    cout << "\nMatricea de adiacenta:\n";
    for (int i = 1; i <= n; i++) 
    {
        for (int j = 1; j <= n; j++)
            cout << a[i][j] << " ";
        cout << endl;
    }
}

void init_v()
{
    for (int i = 0; i < 10; i++) {
        v[i] = 0;
    }
}

void bfs(int start)
{
    int i, k, st, dr, x[10];
    // Adaug varful initial in coada
    st = dr = 1;
    x[1] = start;
    // Vizitez varful
    v[start] = 1;

    // Cat timp coada != goala
    while(st<=dr) {
        // Extragem un element din coada
        k = x[st];
        // Afisam elementul
        cout << k << " ";

        // Determin vecinii
        for(int i = 1; i <= n; i++)
        {
            // Daca nu e vizitat si i este vecin
            if(v[i] == 0 && a[k][i] == 1) {
                // Vizitez varful si il adaug in coada
                v[i] = 1;
                x[++dr] = i;
            }
        }
        // "Sterg" din coada
        st++;
    }
}

void dfs(int k)
{
    v[k] = 1;
    cout << k << " ";

    for (int i = 1; i <= n; i++) {
        if (a[k][i] && v[i] == 0) {
            dfs(i);
        }
    }
}


int main()
{
    creare_matrice_adiacenta();
    afisare_adiacenta();

    cout << "\n\nMetoda de parcurgere in latime (BFS) din fiecare nod al grafului: ";
    for(int i = 1; i <= n; i++)
    {
        cout << "\ndin nodul " << i << " : ";
        bfs(i);
        init_v();
    }

    cout << "\n\nMetoda de parcurgere in adancime (DFS) din fiecare nod al grafului: ";
    for(int i = 1; i <= n; i++)
    {
        cout << "\ndin nodul " << i << " : ";
        dfs(i);
        init_v();
    }
}
